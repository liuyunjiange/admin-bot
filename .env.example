# 飞书企业自建应用
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOMAIN=feishu

# 模型平台 Admin 接口
ADMIN_API_BASE_URL=http://host.docker.internal:23351
ADMIN_SERVICE_TOKEN=
ADMIN_API_TIMEOUT_SECONDS=30

# 首次获取 open_id 时可留空；正式使用必须填写，多个 open_id 使用逗号分隔
DEMO_ACCOUNT_ALLOWED_OPEN_IDS=
DEMO_ACCOUNT_SESSION_TTL_MINUTES=30

# 健康检查
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
LOG_LEVEL=INFO

# Docker Hub 访问受限时可改为企业镜像仓库地址
PYTHON_BASE_IMAGE=python:3.12.10-slim
